# Classification: llm | keyword
CLASSIFICATION_ENGINE=llm

# direct = Python sends via gog after triage | delegate = specialist agents
DISPATCH_STRATEGY=direct

# Azure OpenAI (LLM classification)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Gmail / gog
GMAIL_SENDER=your-inbox@gmail.com
EMAIL_TRIAGE_AGENT_ID=triage-coordinator
GOG_KEYRING_PASSWORD=

# Azure Blob archive (optional)
AZURE_BLOB_CONTAINER=openclaw-ul
AZURE_BLOB_CONNECTION_STRING=

# Gateway (native hooks.gmail)
OPENCLAW_GATEWAY_BIND=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_HOOKS_PATH=/hooks

# Optional tuning
MIN_LLM_CONFIDENCE=0.45
LLM_TIMEOUT_SECONDS=45
DOC_PREVIEW_MAX_CHARS=2500
